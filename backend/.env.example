# Copy to .env and adjust for your environment.
DATABASE_URL=mysql+pymysql://root:PASSWORD@localhost:3306/emperical
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=1440

# Comma-separated list of browser origins allowed to call this API.
# The deployed frontend origin MUST be listed or every request fails CORS.
CORS_ORIGINS=http://localhost:3000,https://irmms.org

# Public site URL (including any sub-path) — used for password-reset links.
SITE_URL=https://irmms.org/emperical-publication

# Seeded on first `python seed.py` run. Use a strong, unique password —
# anything committed or well-known is a live credential once deployed.
ADMIN_EMAIL=admin@empericalpublication.com
ADMIN_PASSWORD=change-me-before-seeding

# Manuscript uploads. UPLOAD_DIR must be writable by the app user.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# SMTP for password-reset emails. Leave SMTP_HOST blank to disable sending
# (tokens are still created and the message is written to the server log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
